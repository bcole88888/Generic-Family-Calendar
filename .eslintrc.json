{
    "env": {
        "node": true,
        "es2021": true,
        "browser": true,
        "jest": true
    },
    "extends": [
        "eslint:recommended",
        "plugin:node/recommended",
        "prettier"
    ],
    "parserOptions": {
        "ecmaVersion": 12,
        "sourceType": "module"
    },
    "rules": {
        "no-console": "off",
        "no-unused-vars": [
            "warn",
            {
                "argsIgnorePattern": "^_"
            }
        ],
        "node/no-unsupported-features/es-syntax": "off",
        "node/no-missing-require": "off"
    },
    "overrides": [
        {
            "files": [
                "public/**/*.js"
            ],
            "env": {
                "browser": true,
                "node": false
            },
            "rules": {
                "no-undef": "off",
                "no-unused-vars": "off",
                "node/no-unsupported-features/es-syntax": "off"
            }
        }
    ]
}