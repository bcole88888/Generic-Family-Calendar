[Unit]
Description=Family Calendar Application
Documentation=file:///root/familycalendar/README.md
After=network.target

[Service]
EnvironmentFile=/root/familycalendar/.env
Type=simple
User=root
WorkingDirectory=/root/familycalendar
Environment=NODE_ENV=production
ExecStart=/usr/bin/node app.js
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStopSec=5

# Output to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=familycalendar

# Security settings
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/root/familycalendar/data
ReadWritePaths=/root/familycalendar/logs

[Install]
WantedBy=multi-user.target