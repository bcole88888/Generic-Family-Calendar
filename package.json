{
  "name": "familycalendar",
  "version": "1.0.0",
  "description": "Family Calendar and Chore Tracking Application",
  "main": "main.js",
  "homepage": "./",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "electron-builder",
    "build-linux": "electron-builder --linux",
    "build-all": "electron-builder --linux --windows --mac",
    "dist": "npm run build",
    "pack": "electron-builder --dir",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "jest"
  },
  "keywords": [
    "calendar",
    "family",
    "chores",
    "touchscreen"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.12.2",
    "caldav": "^0.0.1",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "electron-is-dev": "^2.0.0",
    "express": "^5.1.0",
    "googleapis": "^163.0.0",
    "ical.js": "^2.2.1",
    "mammoth": "^1.11.0",
    "moment": "^2.30.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "pdf-parse": "~1.1.1",
    "tsdav": "^2.1.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^30.2.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.6.2",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.familycalendar.app",
    "productName": "Family Calendar",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!node_modules/**/*",
      "!.git/**/*",
      "!*.md",
      "!*.log"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "assets/icon.png",
      "desktop": {
        "Name": "Family Calendar",
        "Comment": "Family Calendar and Chore Tracking Application",
        "GenericName": "Calendar",
        "Keywords": "calendar;family;chores;tasks;"
      }
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    }
  }
}
